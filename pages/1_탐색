import pandas as pd
import plotly.express as px
import streamlit as st

# ------------------------------------------------------------------
# 기본 설정
# ------------------------------------------------------------------
PAGE_TITLE = "탐색"
PAGE_ICON = "🔍"

st.set_page_config(page_title=f"{PAGE_TITLE} - 뇌졸중 예측 실습실", page_icon=PAGE_ICON, layout="wide")

DATA_URL = (
    "https://raw.githubusercontent.com/mangonn0625/data/"
    "refs/heads/main/stroke.csv"
)

STROKE_LABELS = {0: "뇌졸중 겪지 않음", 1: "뇌졸중 겪음"}
YES_NO_LABELS = {0: "없음", 1: "있음"}


# ------------------------------------------------------------------
# 데이터 불러오기 (첫 화면과 같은 데이터, 같은 주소, UTF-8)
# ------------------------------------------------------------------
@st.cache_data(show_spinner="데이터를 불러오는 중입니다...")
def load_data(url: str) -> pd.DataFrame:
    return pd.read_csv(url, encoding="utf-8")


def stroke_rate_bar(data: pd.DataFrame, column: str, title: str):
    """어떤 열의 값(0/1)마다 뇌졸중 비율(%)을 막대그래프로 만든다."""
    rate = (
        data.groupby(column)["stroke"]
        .agg(비율="mean", 사람수="size")
        .reset_index()
    )
    rate["비율"] = (rate["비율"] * 100).round(2)
    rate["구분"] = rate[column].map(YES_NO_LABELS)
    fig = px.bar(
        rate,
        x="구분",
        y="비율",
        text="비율",
        hover_data={"사람수": True, "구분": False},
        title=title,
        labels={"구분": title.split(" ")[0], "비율": "뇌졸중 비율(%)"},
        category_orders={"구분": ["없음", "있음"]},
    )
    fig.update_traces(texttemplate="%{text:.2f}%", textposition="outside")
    fig.update_yaxes(range=[0, max(rate["비율"].max() * 1.25, 1)])
    return fig


# ------------------------------------------------------------------
# 화면 시작
# ------------------------------------------------------------------
st.title(f"{PAGE_ICON} 탐색")
st.caption("데이터를 여러 방향에서 살펴봅니다.")

try:
    df = load_data(DATA_URL)
except Exception as e:  # 네트워크 오류 등
    st.error("데이터를 불러오지 못했습니다. 인터넷 연결을 확인하고 새로고침해 주세요.")
    st.exception(e)
    st.stop()

df = df.copy()
df["뇌졸중 여부"] = df["stroke"].map(STROKE_LABELS)

# ------------------------------------------------------------------
# 1) 나이와 평균 혈당의 분포
# ------------------------------------------------------------------
st.header("1. 나이와 평균 혈당의 분포")
col_a, col_b = st.columns(2)
with col_a:
    fig = px.histogram(
        df,
        x="age",
        nbins=30,
        title="나이 분포",
        labels={"age": "나이", "count": "사람 수"},
    )
    fig.update_layout(yaxis_title="사람 수", bargap=0.05)
    st.plotly_chart(fig)
with col_b:
    fig = px.histogram(
        df,
        x="avg_glucose_level",
        nbins=40,
        title="평균 혈당 분포",
        labels={"avg_glucose_level": "평균 혈당"},
    )
    fig.update_layout(yaxis_title="사람 수", bargap=0.05)
    st.plotly_chart(fig)

# ------------------------------------------------------------------
# 2) 뇌졸중 여부에 따른 비교
# ------------------------------------------------------------------
st.header("2. 뇌졸중을 겪은 사람과 겪지 않은 사람 비교")
order = {"뇌졸중 여부": [STROKE_LABELS[0], STROKE_LABELS[1]]}
col_a, col_b = st.columns(2)
with col_a:
    fig = px.box(
        df,
        x="뇌졸중 여부",
        y="age",
        color="뇌졸중 여부",
        title="나이 비교",
        labels={"age": "나이"},
        category_orders=order,
    )
    fig.update_layout(showlegend=False)
    st.plotly_chart(fig)
with col_b:
    fig = px.box(
        df,
        x="뇌졸중 여부",
        y="avg_glucose_level",
        color="뇌졸중 여부",
        title="평균 혈당 비교",
        labels={"avg_glucose_level": "평균 혈당"},
        category_orders=order,
    )
    fig.update_layout(showlegend=False)
    st.plotly_chart(fig)

st.subheader("두 그룹의 평균값")
mean_table = (
    df.groupby("뇌졸중 여부")
    .agg(
        사람_수=("id", "size"),
        평균_나이=("age", "mean"),
        평균_혈당=("avg_glucose_level", "mean"),
    )
    .reindex(order["뇌졸중 여부"])
    .round(2)
    .reset_index()
)
mean_table.columns = ["그룹", "사람 수", "평균 나이", "평균 혈당"]
st.dataframe(mean_table, hide_index=True)

# ------------------------------------------------------------------
# 3) 고혈압·심장병과 뇌졸중 비율
# ------------------------------------------------------------------
st.header("3. 고혈압·심장병에 따른 뇌졸중 비율")
col_a, col_b = st.columns(2)
with col_a:
    st.plotly_chart(stroke_rate_bar(df, "hypertension", "고혈압 유무별 뇌졸중 비율"))
with col_b:
    st.plotly_chart(stroke_rate_bar(df, "heart_disease", "심장병 유무별 뇌졸중 비율"))

# ------------------------------------------------------------------
# 4) bmi가 빈 사람들
# ------------------------------------------------------------------
st.header("4. 체질량지수(bmi)가 비어 있는 사람들")
bmi_empty = df[df["bmi"].isna()]


def summarize(label: str, data: pd.DataFrame) -> dict:
    people = len(data)
    stroke_people = int((data["stroke"] == 1).sum())
    rate = stroke_people / people * 100 if people else 0.0
    return {
        "구분": label,
        "사람 수": people,
        "뇌졸중 사람 수": stroke_people,
        "뇌졸중 비율(%)": round(rate, 2),
    }


bmi_table = pd.DataFrame(
    [
        summarize("bmi가 빈 사람", bmi_empty),
        summarize("전체", df),
    ]
)
st.dataframe(bmi_table, hide_index=True)

# ------------------------------------------------------------------
# 5) 흡연 상태별 사람 수
# ------------------------------------------------------------------
st.header("5. 흡연 상태별 사람 수")
smoking_table = (
    df["smoking_status"]
    .value_counts(dropna=False)
    .rename_axis("흡연 상태")
    .reset_index(name="사람 수")
)
st.dataframe(smoking_table, hide_index=True)
